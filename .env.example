# Copy this file to .env and fill in your own details:
#
#     Windows :  copy .env.example .env
#     Mac/Linux: cp .env.example .env
#
# .env is gitignored, so your details stay on your machine. This .example file is
# committed so anyone cloning the project can see which settings exist.

# REQUIRED. The SEC requires automated callers to identify themselves with a genuine
# contact address in the User-Agent header. Requests without one may be blocked.
# See https://www.sec.gov/os/webmaster-faq#developers
SEC_CONTACT_EMAIL=your-email@example.com

# OPTIONAL. Leave blank to use FRED's public CSV endpoint, which needs no registration.
# Free key: https://fredaccount.stlouisfed.org/apikeys
# FRED_API_KEY=

# --- Emailing the daily digest (scripts/send_digest.py) ------------------------------
# OPTIONAL. Only needed if you want the digest mailed to you.
#
# Gmail will NOT accept your normal password. You need an "App Password": a 16-digit
# code Google issues per-application, which requires 2-Step Verification first.
#   1. https://myaccount.google.com/signinoptions/two-step-verification
#   2. https://myaccount.google.com/apppasswords
# Run `python scripts/send_digest.py --setup` for the full walkthrough.
#
# NEVER put this password in a .py file - this repository is public, and a secret that
# reaches git history stays there even after you delete the file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_APP_PASSWORD=your16charapppassword
DIGEST_TO=your.address@gmail.com
# DIGEST_FROM=            # optional, defaults to SMTP_USER
